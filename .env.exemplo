# Copie para .env (o git ignora). Nada aqui é obrigatório: há padrões no código.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO_BASE=qwen2.5:1.5b-instruct
OLLAMA_MODELO_LORA=passo-seguro-lora
MODELO_HF=Qwen/Qwen2.5-1.5B-Instruct
MODELO_EMBEDDINGS=intfloat/multilingual-e5-base
TOP_K=3
# Reranker: reordena os 10 candidatos do e5. Vazio = só a busca densa. O BAAI/bge-reranker-v2-m3 acerta
# um pouco mais, mas leva ~11 s por pergunta em CPU (estoura o prazo da API): use só com GPU.
MODELO_RERANKER=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
CANDIDATOS=10
# LIMIAR=0.17            # normalmente vem de avaliacao/limiar.json (04_avaliar_busca.py)

# Modelo professor para gerar os exemplos do LoRA (06_gerar_exemplos.py)
PROFESSOR_MODELO=qwen2.5:7b-instruct
# Ou uma API compatível com OpenAI (ex.: Groq). NUNCA commite a chave.
# PROFESSOR_URL=https://api.groq.com/openai/v1
# PROFESSOR_CHAVE=
# PROFESSOR_MODELO=llama-3.3-70b-versatile

# Serviço /assistente
ASSISTENTE_TOKEN=token-local
CONFIG_VENCEDORA=C
